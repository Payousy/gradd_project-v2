---

<section class="hero-section">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-text fade-up">
        <span class="section-eyebrow">Notre positionnement</span>
        <h2 class="section-title">Une expertise collective, au plus près des réalités locales</h2>
        <div class="gold-divider"></div>
        <p>
          Chaque intervention mobilise des approches participatives, inclusives
          et pluridisciplinaires, portées par une équipe de sociologues aux
          expériences complémentaires.
        </p>
        <a href="/contact" class="btn btn-primary">Nous contacter</a>

        <div class="hero-stat-row">
          <div class="hero-stat">
            <strong>10</strong>
            <span>Sociologues associés</span>
          </div>
          <div class="hero-stat">
            <strong>6</strong>
            <span>Secteurs d'expertise</span>
          </div>
          <div class="hero-stat">
            <strong>Sénégal</strong>
            <span>Ancrage territorial</span>
          </div>
        </div>
      </div>

      <div class="hero-image-block fade-up">
        <img
          src="/images/enquete_ecv.jpg"
          alt="Enquête de terrain GRADD au Sénégal"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
