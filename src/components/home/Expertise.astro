---
const competences = [
  {
    title: "Études sociologiques & diagnostics territoriaux",
    desc: "Analyses qualitatives et quantitatives des dynamiques sociales, culturelles et territoriales propres aux contextes d'intervention."
  },
  {
    title: "Suivi-évaluation de projets et politiques publiques",
    desc: "Dispositifs rigoureux permettant de mesurer les résultats, les effets et l'impact des interventions publiques."
  },
  {
    title: "Études d'impact environnemental et social",
    desc: "Évaluation des impacts sociaux et environnementaux pour assurer la conformité et la durabilité des projets."
  },
  {
    title: "Recherche-action & innovation sociale",
    desc: "Production de connaissances appliquées et accompagnement au changement à travers des démarches participatives."
  },
  {
    title: "Planification stratégique territoriale",
    desc: "Appui à la définition de stratégies intégrant les enjeux sociaux, économiques et environnementaux."
  },
  {
    title: "Appui-conseil aux politiques publiques",
    desc: "Accompagnement des institutions dans la conception, l'adaptation et l'amélioration de leurs dispositifs d'action."
  },
];
---

<section class="expertise-section">
  <div class="container">
    <div class="section-intro section-intro--center fade-up">
      <span class="section-eyebrow">Nos compétences</span>
      <h2 class="section-title">Une expertise sociologique au service de l'action</h2>
      <div class="gold-divider gold-divider--center"></div>
      <p class="section-lead">
        Selon vos objectifs, nous mobilisons des approches qualitatives,
        quantitatives ou hybrides, adaptées à chaque contexte d'intervention.
      </p>
    </div>

    <div class="grid-auto fade-up">
      {competences.slice(0, 3).map(e => (
        <div class="expertise-card">
          <h3>{e.title}</h3>
          <p>{e.desc}</p>
        </div>
      ))}
    </div>

    <p class="fade-up" style="text-align: center; margin-top: var(--space-8);">
      <a href="/domaines-competences" class="btn btn-outline">Voir le détail de nos compétences</a>
    </p>
  </div>
</section>
