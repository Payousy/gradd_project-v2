---
import BaseLayout from "../components/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const fiches = await Promise.all(
  (await getCollection("actions", ({ data }) => data.published))
    .map(async entry => ({ entry, rendered: await render(entry) }))
);
---

<BaseLayout
  title="Nos actions — GRADD"
  description="Exemples de dispositifs d'intervention, de suivi et d'évaluation menés par le GRADD auprès des acteurs publics et des partenaires au développement."
>
  <div class="page-intro">
    <div class="container">
      <span class="section-eyebrow">Nos actions</span>
      <h1>Des dispositifs concrets, au service de vos projets</h1>
      <div class="gold-divider"></div>
      <p class="section-lead">
        Chaque mission du GRADD s'appuie sur la méthodologie présentée sur
        <a href="/methodologie">notre page méthodologie</a>. Voici quelques
        exemples de dispositifs que nous sommes en mesure de mettre en œuvre.
      </p>
    </div>
  </div>

  <section class="section section--white">
    <div class="container">
      <div class="section-intro">
        <span class="section-eyebrow">Exemples de dispositifs</span>
        <h2 class="section-title">Types de missions menées par le GRADD</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="grid-auto">
        {fiches.map(({ entry, rendered: { Content } }) => (
          <article class="card card--gold-bar">
            <span style="display: inline-block; font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-gold); background: var(--color-gold-light); padding: 2px 8px; border-radius: 2px; margin-bottom: var(--space-3);">
              {entry.data.type}
            </span>
            <h3 style="font-family: var(--font-display); color: var(--color-navy); margin-bottom: var(--space-1);">{entry.data.title}</h3>
            {entry.data.territoire && (
              <p style="font-size: var(--text-xs); color: var(--color-muted); margin-bottom: var(--space-4);">📍 {entry.data.territoire}</p>
            )}
            <div style="font-size: var(--text-sm);">
              <Content />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Construire des dispositifs efficaces et durables</h2>
      <p>Vous souhaitez concevoir, suivre ou évaluer un projet ou une politique publique ?</p>
      <a href="/contact" class="btn btn-primary" style="background-color: var(--color-gold); border-color: var(--color-gold); color: var(--color-navy)">
        Nous contacter
      </a>
    </div>
  </section>
</BaseLayout>
