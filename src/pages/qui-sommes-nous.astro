---
import BaseLayout from "../components/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const BIO_PLACEHOLDER = "Biographie à compléter (parcours, spécialité, projets marquants).";

const equipeRaw = (await getCollection("team", ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);

const equipe = await Promise.all(
  equipeRaw.map(async (membre) => ({
    membre,
    hasBio: membre.body?.trim() !== BIO_PLACEHOLDER,
    rendered: await render(membre),
  }))
);
---

<BaseLayout
  title="Qui sommes-nous ? — GRADD"
  description="Découvrez l'histoire, l'équipe et les valeurs du GRADD, cabinet d'études et conseil en développement durable au Sénégal."
>
  <div class="page-intro">
    <div class="container">
      <span class="section-eyebrow">Le cabinet</span>
      <h1>Qui sommes-nous ?</h1>
      <div class="gold-divider"></div>
      <p class="section-lead">
        GRADD est un cabinet d'études et de conseil né de l'initiative d'un groupe
        de sociologues engagés, désireux de mettre leur expertise au service de
        l'action publique et des politiques de développement.
      </p>
    </div>
  </div>

  <section class="section section--white">
    <div class="container">
      <div class="grid-2" style="gap: var(--space-16); align-items: start;">
        <div>
          <span class="section-eyebrow">Notre genèse</span>
          <h2 class="section-title">Une aventure collective, née de parcours individuels</h2>
          <div class="gold-divider"></div>
          <p>
            GRADD est né d'un groupe d'amis sociologues qui, après l'obtention
            de leur Master, ont chacun construit leur propre parcours au sein
            de projets de développement — en mise en œuvre comme en
            suivi-évaluation — dans des secteurs aussi variés que la santé,
            l'éducation, l'environnement, la pêche, l'agriculture ou l'action
            sociale.
          </p>
          <p>
            Certains d'entre eux se sont déjà retrouvés, à 5 ou 6, sur des
            missions communes. Mais c'est en confrontant l'ensemble de ces
            expériences individuelles qu'est née une conviction partagée :
            réunir cette diversité de parcours au sein d'une même structure
            permettrait de proposer une expertise plus riche et mieux
            articulée aux institutions et partenaires du développement.
          </p>
          <p>
            GRADD est ainsi une jeune structure de conseil — mais portée par
            dix sociologues qui, individuellement, ont déjà l'expérience du
            terrain sénégalais et de ses réalités.
          </p>
        </div>
        <div>
          <img
            src="/images/journee_formation.jpg"
            alt="Journée de formation GRADD"
            style="border-radius: var(--radius-lg); width: 100%; height: 380px; object-fit: cover;"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bg">
    <div class="container">
      <div class="section-intro section-intro--center">
        <span class="section-eyebrow">Nos valeurs</span>
        <h2 class="section-title">Ce qui guide notre action</h2>
        <div class="gold-divider gold-divider--center"></div>
      </div>

      <div class="grid-auto">
        {[
          { v: "Rigueur scientifique", d: "Des analyses fondées sur des méthodes éprouvées et un cadrage théorique solide." },
          { v: "Engagement éthique", d: "Indépendance de l'analyse, transparence des résultats, respect des acteurs de terrain." },
          { v: "Pertinence contextuelle", d: "Des approches toujours adaptées aux spécificités sociales, culturelles et territoriales." },
          { v: "Utilité sociale", d: "Des recommandations concrètes et opérationnelles au service des populations." },
        ].map(item => (
          <div class="card card--gold-bar">
            <h3 style="font-size: var(--text-base); font-family: var(--font-base); font-weight: 700;">{item.v}</h3>
            <p style="font-size: var(--text-sm); margin: 0;">{item.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-intro section-intro--center">
        <span class="section-eyebrow">L'équipe</span>
        <h2 class="section-title">{equipe.length} membres associés</h2>
        <div class="gold-divider gold-divider--center"></div>
        <p class="section-lead">
          Une équipe pluridisciplinaire, réunissant des expériences de terrain
          complémentaires au service de vos projets.
        </p>
      </div>

      <div class="grid-auto">
        {equipe.map(({ membre, hasBio, rendered: { Content } }) => (
          <div class="card card--gold-bar member-card">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--color-navy); color: var(--color-white); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: var(--text-lg); margin: 0 auto var(--space-4);">
              {membre.data.name.charAt(0)}
            </div>
            <h3 style="font-family: var(--font-display); color: var(--color-navy); margin-bottom: var(--space-1);">{membre.data.name}</h3>
            <p style="font-size: var(--text-sm); color: var(--color-muted); margin-bottom: var(--space-2);">{membre.data.role}</p>
            {hasBio && (
              <div class="member-bio">
                <Content />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Travaillons ensemble</h2>
      <p>Vous avez un projet d'étude ou d'évaluation ? Contactez-nous.</p>
      <a href="/contact" class="btn btn-primary" style="background-color: var(--color-gold); border-color: var(--color-gold); color: var(--color-navy)">
        Prendre contact
      </a>
    </div>
  </section>
</BaseLayout>

<style>
.member-card {
  text-align: center;
}

.member-bio {
  text-align: left;
  margin-top: var(--space-4);
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border);
}

.member-bio :global(p) {
  font-size: var(--text-sm);
  line-height: 1.6;
  margin: 0;
}
</style>
